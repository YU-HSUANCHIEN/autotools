{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/LINE-MID/webhook", "destination": "/LINE-MID/api/webhook" },
    { "source": "/LINE-MID/api/mids", "destination": "/LINE-MID/api/mids" }
  ]
}
